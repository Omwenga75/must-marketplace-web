{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",

    "products": {
      ".read": true,
      "$productId": {
        ".write": "auth != null",
        "likes": {
          ".write": true
        },
        "views": {
          ".write": true
        }
      }
    },

    "favorites": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId"
      }
    },

    "product_likes": {
      "$productId": {
        ".read": true,
        "$userId": {
          ".write": "auth != null && auth.uid === $userId"
        }
      }
    },

    "product_views": {
      "$productId": {
        ".read": true,
        "$userId": {
          ".write": "auth != null && (auth.uid === $userId || $userId.startsWith('guest_'))"
        }
      }
    },

    "deleted_products": {
      ".read": true,
      ".write": "auth != null"
    },

    "deleted_users": {
      ".read": true,
      ".write": "auth != null"
    },

    "users": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "admin_broadcasts": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "conversations": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "messages": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "chatroom": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
