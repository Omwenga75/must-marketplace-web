{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",

    "products": {
      ".read": true,
      "$productId": {
        ".write": "auth != null",
        "likes": {
          ".write": true
        },
        "views": {
          ".write": true
        }
      }
    },

    "favorites": {
      "$userId": {
        ".read": "(auth != null && auth.uid === $userId) || $userId.beginsWith('demo_')",
        ".write": "(auth != null && auth.uid === $userId) || $userId.beginsWith('demo_')"
      }
    },

    "product_likes": {
      "$productId": {
        ".read": true,
        "$userId": {
          ".write": "(auth != null && auth.uid === $userId) || $userId.beginsWith('demo_')"
        }
      }
    },

    "product_views": {
      "$productId": {
        ".read": true,
        "$userId": {
          ".write": "(auth != null && auth.uid === $userId) || $userId.beginsWith('demo_') || (auth == null && $userId.beginsWith('guest_'))"
        }
      }
    },

    "deleted_products": {
      ".read": true,
      ".write": "auth != null"
    },

    "deleted_users": {
      ".read": true,
      ".write": "auth != null"
    },

    "users": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "admin_broadcasts": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "conversations": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "messages": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "chatroom": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
